#usda 1.0
(
    defaultPrim = "MoeckelPondFilm"
    metersPerUnit = 1
    upAxis = "Y"
    timeCodesPerSecond = 24
    framesPerSecond = 24
    startTimeCode = 0
    endTimeCode = 995
    autoPlay = true
    playbackMode = "loop"
)
def Xform "MoeckelPondFilm" (prepend apiSchemas = ["Preliminary_AnchoringAPI"]) {
    uniform token preliminary:anchoring:type = "plane"
    uniform token preliminary:planeAnchoring:alignment = "vertical"
    def Scope "Materials" {
def Material "Walnut" {
token outputs:surface.connect = </MoeckelPondFilm/Materials/Walnut/Surface.outputs:surface>
def Shader "Surface" {
uniform token info:id = "UsdPreviewSurface"
color3f inputs:diffuseColor = (0.076, 0.038, 0.02)
float inputs:roughness = 0.62
float inputs:metallic = 0

token outputs:surface
}
}
def Material "Bronze" {
token outputs:surface.connect = </MoeckelPondFilm/Materials/Bronze/Surface.outputs:surface>
def Shader "Surface" {
uniform token info:id = "UsdPreviewSurface"
color3f inputs:diffuseColor = (0.37, 0.27, 0.13)
float inputs:roughness = 0.44
float inputs:metallic = 0.62

token outputs:surface
}
}
def Material "Paper" {
token outputs:surface.connect = </MoeckelPondFilm/Materials/Paper/Surface.outputs:surface>
def Shader "Surface" {
uniform token info:id = "UsdPreviewSurface"
color3f inputs:diffuseColor = (0.83, 0.78, 0.65)
float inputs:roughness = 0.96
float inputs:metallic = 0

token outputs:surface
}
}
def Material "Backing" {
token outputs:surface.connect = </MoeckelPondFilm/Materials/Backing/Surface.outputs:surface>
def Shader "Surface" {
uniform token info:id = "UsdPreviewSurface"
color3f inputs:diffuseColor = (0, 0, 0)
float inputs:roughness = 1
float inputs:metallic = 0
color3f inputs:emissiveColor.connect = </MoeckelPondFilm/Materials/Backing/Texture.outputs:rgb>
token outputs:surface
}
def Shader "UV" {
uniform token info:id = "UsdPrimvarReader_float2"
string inputs:varname = "st"
float2 outputs:result
}
def Shader "Texture" {
uniform token info:id = "UsdUVTexture"
asset inputs:file = @textures/opening.jpg@
token inputs:sourceColorSpace = "sRGB"
token inputs:wrapS = "clamp"
token inputs:wrapT = "clamp"
float2 inputs:st.connect = </MoeckelPondFilm/Materials/Backing/UV.outputs:result>
float3 outputs:rgb
}
}
{{FILM_MATERIALS}}
}
