point3f[] points = [(-0.3195, 0.0185, 0.19), (0.3195, 0.0185, 0.19), (0.3195, 0.0185, -0.19), (-0.3195, 0.0185, -0.19), (-0.3185, 0.0193, 0.189), (0.3185, 0.0193, 0.189), (0.3185, 0.0193, -0.189), (-0.3185, 0.0193, -0.189), (-0.3175, 0.0178, 0.188), (0.3175, 0.0178, 0.188), (0.3175, 0.0178, -0.188), (-0.3175, 0.0178, -0.188)]
